# AlphaMinter Environment Configuration
# Copy this file to .env and fill in your Telegram details

# Telegram Bot Credentials (Get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Personal Chat ID (Get from @userinfobot on Telegram)
TELEGRAM_CHAT_ID=your_numeric_chat_id_here

# Optional: Minimum thresholds for alerts
MIN_DELIVERY_PCT=60.0
MIN_VOLUME_SPIKE_X=2.0
MIN_PAT_GROWTH_PCT=25.0
