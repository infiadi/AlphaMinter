# AlphaMinter Environment Configuration
# Copy this file to .env and fill in your credentials

# Telegram Bot Credentials (Get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Personal Chat ID (Get from @userinfobot on Telegram)
TELEGRAM_CHAT_ID=your_numeric_chat_id_here

# Cloudflare Worker URL
WORKER_URL=https://alphaminter-bot.adityabhandari162.workers.dev

# Google Gemini API Key (Free tier 500 requests/day for 20%+ guidance extraction)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Minimum thresholds for alerts
MIN_DELIVERY_PCT=65.0
MIN_DELIVERY_TURNOVER_CR=5.0
MIN_VOLUME_SPIKE_X=2.5
MIN_PAT_GROWTH_PCT=30.0
